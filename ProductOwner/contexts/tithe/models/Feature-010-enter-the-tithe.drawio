        <UserObject id="AGG-01" label="&lt;b&gt;Tithe&lt;/b&gt;&lt;br&gt;Name&lt;br&gt;Seed&lt;br&gt;&lt;b&gt;Depths (many)&lt;/b&gt;&lt;br&gt;· Number&lt;br&gt;· Layout&lt;br&gt;· Seals at&lt;br&gt;&lt;b&gt;Candidates (many)&lt;/b&gt;&lt;br&gt;· Name&lt;br&gt;· Kind&lt;br&gt;· Party&lt;br&gt;· Level&lt;br&gt;· Start room&lt;br&gt;· Depth&lt;br&gt;· Status&lt;br&gt;Warden alive" tooltip="One run into the Maw: its seed and depths, its candidates (the player and the rivals), the monsters, the Warden and the outcome.">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#FFFF66;strokeColor=#CCCC00;" vertex="1">
