        <mxCell id="CMD-01" parent="1" style="rounded=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#66B2FF;strokeColor=#6C8EBF;" value="&lt;b&gt;Start the Tithe&lt;/b&gt;&lt;br&gt;&lt;b&gt;Players (many)&lt;/b&gt;&lt;br&gt;· Player&lt;br&gt;· Character&lt;br&gt;NPC rivals" vertex="1">
