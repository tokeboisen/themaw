          <mxGeometry x="-120" y="-240" width="1120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DESCRIPTION" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;Description&lt;/b&gt;&lt;/div&gt;For the player: the Maw fights back – monsters hunt the candidates, a sealed depth collapses, hunger grows – and potions and rations help, so every Tithe is a fight to stay alive." vertex="1">
